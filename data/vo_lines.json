   "who": "runner",
   "ev": "hurt",
   "emotion": "angry",
   "text": "Ow! Cheap shot!"
  },
  {
   "id": "runner_hurt_2",
   "who": "runner",
   "ev": "hurt",
   "emotion": "angry",
   "text": "Ah!"
  },
  {
   "id": "runner_death_1",
   "who": "runner",
