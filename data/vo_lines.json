 "lines": [
  {
   "id": "son_kill_1",
   "who": "son",
   "ev": "kill",
   "emotion": "happy",
   "text": "Parkour! On your face."
  },
  {
   "id": "son_kill_2",
   "who": "son",
   "ev": "kill",
   "emotion": "happy",
   "text": "Your spine just unsubscribed."
  },
  {
   "id": "son_kill_3",
   "who": "son",
   "ev": "kill",
   "emotion": "surprised",
   "text": "Dad, I think he's dead. Is this a learning moment?"
  },
  {
   "id": "son_kill_4",
   "who": "son",
   "ev": "kill",
   "emotion": "none",
   "text": "I'm not violent. I'm cardio with consequences."
  },
  {
   "id": "son_kill_5",
   "who": "son",
   "ev": "kill",
   "emotion": "disgusted",
   "text": "Ugh. It got in my shoes."
  },
  {
   "id": "son_combo_1",
   "who": "son",
   "ev": "combo",
   "emotion": "happy",
   "text": "Flip, kick, therapy later!"
  },
  {
   "id": "son_combo_2",
   "who": "son",
   "ev": "combo",
   "emotion": "happy",
   "text": "Look, no hands! Also, no teeth. His."
  },
  {
   "id": "son_combo_3",
   "who": "son",
   "ev": "combo",
   "emotion": "happy",
   "text": "Ten out of ten, would kick again."
  },
  {
   "id": "son_combo_4",
   "who": "son",
   "ev": "combo",
   "emotion": "none",
   "text": "I learned that on the internet. Mostly the bad parts."
  },
  {
   "id": "son_hurt_1",
   "who": "son",
   "ev": "hurt",
   "emotion": "angry",
   "text": "Ow! That's going in my diary!"
  },
  {
   "id": "son_hurt_2",
   "who": "son",
   "ev": "hurt",
   "emotion": "fearful",
   "text": "Not the face! Dad, he did the face!"
  },
  {
   "id": "son_block_1",
   "who": "son",
   "ev": "block",
   "emotion": "happy",
   "text": "Nope."
  },
  {
   "id": "father_kill_1",
   "who": "father",
   "ev": "kill",
   "emotion": "none",
   "text": "That's for the late fees."
  },
  {
   "id": "father_kill_2",
   "who": "father",
   "ev": "kill",
   "emotion": "none",
   "text": "Stay down. It's cheaper."
  },
  {
   "id": "father_kill_3",
   "who": "father",
   "ev": "kill",
   "emotion": "calm",
   "text": "Somebody mop that up. Not me. Somebody."
  },
  {
   "id": "father_kill_4",
   "who": "father",
   "ev": "kill",
   "emotion": "none",
   "text": "Your dental plan just expired."
  },
  {
   "id": "father_kill_5",
   "who": "father",
   "ev": "kill",
   "emotion": "sad",
   "text": "I'm getting too old for this. Hand me the next one."
  },
  {
   "id": "father_combo_1",
   "who": "father",
   "ev": "combo",
   "emotion": "angry",
   "text": "That elbow was forty years of overtime."
  },
  {
   "id": "father_combo_2",
   "who": "father",
   "ev": "combo",
   "emotion": "none",
   "text": "Son, never do what I just did. Unless it works."
  },
  {
   "id": "father_combo_3",
   "who": "father",
   "ev": "combo",
   "emotion": "calm",
   "text": "I'm not angry. I'm just billing you."
  },
  {
   "id": "father_combo_4",
   "who": "father",
   "ev": "combo",
   "emotion": "none",
   "text": "Back in my day we had one fist. We shared it."
  },
  {
   "id": "father_hurt_1",
   "who": "father",
   "ev": "hurt",
   "emotion": "angry",
   "text": "My back! My actual back!"
  },
  {
   "id": "father_hurt_2",
   "who": "father",
   "ev": "hurt",
   "emotion": "angry",
   "text": "Ow. Okay. Now I'm motivated."
  },
  {
   "id": "father_block_1",
   "who": "father",
   "ev": "block",
   "emotion": "calm",
   "text": "Cute."
  },
  {
   "id": "thug_taunt_1",
   "who": "thug",
   "ev": "taunt",
   "emotion": "happy",
   "text": "Hand over the wallet. Or the kidney. Your call."
  },
  {
   "id": "thug_taunt_2",
   "who": "thug",
   "ev": "taunt",
   "emotion": "none",
   "text": "I got a family! I owe them money too."
  },
  {
   "id": "thug_taunt_3",
   "who": "thug",
   "ev": "taunt",
   "emotion": "none",
   "text": "Is this a robbery? I forget. Long day."
  },
  {
   "id": "thug_hurt_1",
   "who": "thug",
   "ev": "hurt",
   "emotion": "angry",
   "text": "Ow! My everything!"
  },
  {
   "id": "thug_death_1",
   "who": "thug",
   "ev": "death",
   "emotion": "sad",
   "text": "Tell my mom... actually don't. She'll gloat."
  },
  {
   "id": "thug_death_2",
   "who": "thug",
   "ev": "death",
   "emotion": "sad",
   "text": "I regret nothing. Wait. Everything."
  },
  {
   "id": "thug_death_3",
   "who": "thug",
   "ev": "death",
   "emotion": "sad",
   "text": "Worth it. No. No it wasn't."
  },
  {
   "id": "mohawk_taunt_1",
   "who": "mohawk",
   "ev": "taunt",
   "emotion": "angry",
   "text": "Bo don't do gentle!"
  },
  {
   "id": "mohawk_taunt_2",
   "who": "mohawk",
   "ev": "taunt",
   "emotion": "angry",
   "text": "I'm gonna fold you like a lawn chair!"
  },
  {
   "id": "mohawk_hurt_1",
   "who": "mohawk",
   "ev": "hurt",
   "emotion": "angry",
   "text": "That's my good hair!"
  },
  {
   "id": "mohawk_death_1",
   "who": "mohawk",
   "ev": "death",
   "emotion": "sad",
   "text": "Bo... is... tired."
  },
  {
   "id": "cop_taunt_1",
   "who": "cop",
   "ev": "taunt",
   "emotion": "none",
   "text": "Stop resisting. I'm on my break."
  },
  {
   "id": "cop_taunt_2",
   "who": "cop",
   "ev": "taunt",
   "emotion": "none",
   "text": "I'm writing you a ticket. For being alive."
  },
  {
   "id": "cop_hurt_1",
   "who": "cop",
   "ev": "hurt",
   "emotion": "angry",
   "text": "That's assault on a public servant! Also on me!"
  },
  {
   "id": "cop_death_1",
   "who": "cop",
   "ev": "death",
   "emotion": "sad",
   "text": "Tell the union... I want overtime for this."
  },
  {
   "id": "shift_lead_taunt_1",
   "who": "shift_lead",
   "ev": "taunt",
   "emotion": "happy",
   "text": "You're clocking out early. Permanently."
  },
  {
   "id": "shift_lead_taunt_2",
   "who": "shift_lead",
   "ev": "taunt",
   "emotion": "none",
   "text": "I'm docking your pay. And your teeth."
  },
  {
   "id": "shift_lead_death_1",
   "who": "shift_lead",
   "ev": "death",
   "emotion": "sad",
   "text": "Who's gonna... approve my timesheet..."
  },
  {
   "id": "gant_taunt_1",
   "who": "gant",
   "ev": "taunt",
   "emotion": "calm",
   "text": "Your account is overdue. So is your funeral."
  },
  {
   "id": "gant_taunt_2",
   "who": "gant",
   "ev": "taunt",
   "emotion": "calm",
   "text": "Interest compounds. So does pain."
  },
  {
   "id": "gant_taunt_3",
   "who": "gant",
   "ev": "taunt",
   "emotion": "happy",
   "text": "Sign here. And here. And here's my fist."
  },
  {
   "id": "gant_hurt_1",
   "who": "gant",
   "ev": "hurt",
   "emotion": "angry",
   "text": "You're denting the paperwork!"
  },
  {
   "id": "gant_death_1",
   "who": "gant",
   "ev": "death",
   "emotion": "sad",
   "text": "This... will go... on your record..."
  },
  {
