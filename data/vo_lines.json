   "ev": "hurt",
   "emotion": "angry",
   "text": "Contempt of court!"
  },
  {
   "id": "bailiff_hurt_2",
   "who": "bailiff",
   "ev": "hurt",
   "emotion": "angry",
   "text": "Hrgh!"
  },
  {
   "id": "bailiff_death_1",
   "who": "bailiff",
   "ev": "death",
   "emotion": "sad",
   "text": "Case... dismissed..."
  },
  {
