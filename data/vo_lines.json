   "text": "Hup!"
  },
  {
   "id": "son_effort_4",
   "who": "son",
   "ev": "effort",
   "emotion": "angry",
   "text": "Hai-yah!"
  },
  {
   "id": "son_effort_5",
   "who": "son",
   "ev": "effort",
   "emotion": "angry",
   "text": "Tsss-hah!"
  },
  {
   "id": "son_effort_6",
   "who": "son",
